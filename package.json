{
  "name": "spacecareer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/update-ip.js && expo start",
    "node-backend": "cd _node_email && node server.js",
    "backend": "cd python && python app.py",
    "avatar-server": "live-server ./assets/live2d --port=5500 --no-browser",
    "dev": "node scripts/update-ip.js && concurrently \"npm run backend\" \"npm run node-backend\" \"npm run avatar-server\" \"npm run start\"",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
